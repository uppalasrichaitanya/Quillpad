# Developer-only fallback endpoints — copy to .env and fill in.
# Normal users set their key in the app (settings → AI key); this file is
# only read when it sits next to the exe or in a parent folder, and only
# these Quillpad-specific names count (standard names like ANTHROPIC_API_KEY
# are deliberately ignored so a stray .env can't leak someone's key).
#
# https://seekai.cc/v1/messages — text distill
QUILLPAD_SEEKAI_KEY=
# https://gorouter.app/v1/messages — vision transcription + text fallback
QUILLPAD_GOROUTER_KEY=
# https://api.inceptionlabs.ai — text fallback
QUILLPAD_INCEPTION_KEY=
